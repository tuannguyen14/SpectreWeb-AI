# SpectreWeb AI - Environment Variables
# Copy this file to .env and fill in your values
# .env file is auto-loaded by python-dotenv (optional dependency)
#
# Install: pip install python-dotenv

# ============================================================================
# CORE SETTINGS
# ============================================================================

# API authentication key (if unset, auth is disabled)
SPECTREWEB_API_KEY=

# Allow raw shell command execution via /api/command (DANGEROUS)
# Only enable in trusted/local environments
SPECTREWEB_ALLOW_COMMAND=false

# Path to SecLists directory (auto-detected if unset)
# Linux: /usr/share/seclists
# Windows: D:\SecLists
SPECTREWEB_SECLISTS_PATH=

# Verify TLS certificates for outbound requests (default: false)
# Pentest targets often use self-signed certs
SPECTREWEB_TLS_VERIFY=false

# ============================================================================
# ORIGIN IP FINDER (optional API keys)
# ============================================================================

# Quake 360 - FREE tier works! (3000 credits/month)
# Register: https://quake.360.net
SPECTREWEB_QUAKE_API_KEY=

# FOFA - PAID only (needs F-points for API search)
# Register: https://fofa.info
SPECTREWEB_FOFA_EMAIL=
SPECTREWEB_FOFA_API_KEY=

# Shodan - InternetDB is free without key, search API needs key
# Register: https://www.shodan.io
SPECTREWEB_SHODAN_API_KEY=

# SecurityTrails - ~50 free queries/month
# Register: https://securitytrails.com
SPECTREWEB_SECURITYTRAILS_API_KEY=

# Censys - ~250 free queries/month
# Register: https://censys.io
SPECTREWEB_CENSYS_API_ID=
SPECTREWEB_CENSYS_API_SECRET=

# Validin - Free account, passive DNS host pivot
# Register: https://app.validin.com
SPECTREWEB_VALIDIN_TOKEN=
